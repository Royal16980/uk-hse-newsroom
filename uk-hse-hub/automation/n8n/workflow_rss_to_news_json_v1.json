      "type": "n8n-nodes-base.merge",
      "typeVersion": 2,
      "position": [
        760,
        280
      ]
    },
    {
      "parameters": {
        "jsCode": "// Normalize RSS items into a simple schema for uk-hse-hub/content/news.json\n\nfunction isoDate(d) {\n  if (!d) return new Date().toISOString().slice(0,10);\n  const dt = new Date(d);\n  if (Number.isNaN(dt.getTime())) return new Date().toISOString().slice(0,10);\n  return dt.toISOString().slice(0,10);\n}\n\nconst items = [];\nfor (const i of $input.all()) {\n  const j = i.json;\n  const url = j.link || j.url || '';\n  const title = j.title || 'Untitled';\n  const published = isoDate(j.isoDate || j.pubDate || j.published || j.date);\n  const source = 'HSE';\n  items.push({\n    id: (url || title).slice(0,120),\n    title,\n    url,\n    source,\n    published,\n    summary: j.contentSnippet || j.content || j.summary || '',\n    actions: []\n  });\n}\n\n// de-dupe by URL\nconst seen = new Set();\nconst deduped = [];\nfor (const it of items) {\n  const key = it.url || it.title;\n  if (seen.has(key)) continue;\n  seen.add(key);\n  deduped.push(it);\n}\n\n// newest first\ndeduped.sort((a,b) => (a.published < b.published ? 1 : -1));\n\n// cap size\nconst capped = deduped.slice(0, 50);\n\nreturn [{ json: { items: capped } }];"
      },
      "id": "code_normalize",
      "name": "Normalize → news.json",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1000,
        280
      ]
    },
    {
      "parameters": {
        "fileName": "C:/Users/ADMIN/clawd/uk-hse-hub/content/news.json",
        "dataPropertyName": "=JSON.stringify($json, null, 2)",
        "options": {}
      },
      "id": "write_file",
